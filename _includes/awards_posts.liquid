<div class="news">
  {% assign awards = site.posts | where_exp: "p", "p.categories contains 'awards'" | sort: "date" | reverse %}
  {% assign awards_size = awards | size %}

  {% if awards_size > 0 %}
    <div
      class="table-responsive"
      {% if page.latest_posts.scrollable and awards_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% if page.latest_posts.limit %}
          {% assign awards_limit = page.latest_posts.limit %}
        {% else %}
          {% assign awards_limit = awards_size %}
        {% endif %}

        {% for item in awards limit: awards_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              <span class="news-title">
                {{ item.content | markdownify | strip_html | strip_newlines }}
              </span>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No awards so far...</p>
  {% endif %}
</div>
